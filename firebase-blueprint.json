{
  "entities": {
    "UserAccount": {
      "title": "NYXON User Account & Cloud Sync Profile",
      "description": "Per-user music library, membership tier (free/pro), playlists, favorites, Liquid Glass theme preferences, and Home layout stored under users/{uid}.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "email": { "type": "string", "description": "User email address." },
        "displayName": { "type": "string", "description": "User display name." },
        "plan": { "type": "string", "enum": ["free", "pro"], "description": "Membership tier." },
        "playlists": { "type": "array", "description": "User playlists." },
        "favoriteIds": { "type": "array", "description": "Favorited track IDs." },
        "themePrefs": { "type": "object", "description": "Liquid Glass theme preferences." },
        "homeLayout": { "type": "array", "description": "Ordered Home screen widgets." },
        "savedTracks": { "type": "array", "description": "Cached external track metadata." },
        "redeemedPromoCode": { "type": "string", "description": "Optional promo code used to activate Pro." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "plan"]
    },
    "PromoCode": {
      "title": "NYXON Pro 1-Time Activation Code",
      "description": "Single-use Pro activation codes generated by Admin and redeemed atomically by users.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "used": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string" },
        "usedByUid": { "type": "string" },
        "usedByEmail": { "type": "string" },
        "usedAt": { "type": "number" }
      },
      "required": ["code", "used", "createdAt", "createdBy"]
    },
    "PaymentAdConfig": {
      "title": "NYXON Payment & Audio Ad Configuration",
      "description": "Admin-configurable Shopier checkout URL and optional custom audio ad MP3 URL.",
      "type": "object",
      "properties": {
        "checkoutUrl": { "type": "string" },
        "customAdAudioUrl": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Per-user profile, membership tier, and cloud-synced music library."
    },
    "/promoCodes/{code}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "1-time NYXON Pro activation codes."
    },
    "/config/payments": {
      "schema": { "$ref": "#/entities/PaymentAdConfig" },
      "description": "Global payment checkout URL and optional custom audio ad URL."
    }
  }
}
