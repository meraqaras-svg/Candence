rules_version = '2';

// NYXON Firestore Security Rules (Project: muzikapptone-c6971)
// Collections:
//   - /users/{userId}: Owner profile, membership plan ('free' | 'pro'), and cloud-synced library
//   - /promoCodes/{code}: Single-use NYXON Pro activation codes
//   - /config/payments: Admin-configurable Shopier checkout URL & custom audio ad URL

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email == 'meraqaras@gmail.com';
    }

    function hasValidPlan(plan) {
      return plan == 'free' || plan == 'pro';
    }

    function isValidUserPayload(userId) {
      let data = request.resource.data;
      return (!('ownerId' in data) || data.ownerId == userId)
        && (!('plan' in data) || hasValidPlan(data.plan))
        && (!('playlists' in data) || (data.playlists is list && data.playlists.size() <= 50))
        && (!('favoriteIds' in data) || (data.favoriteIds is list && data.favoriteIds.size() <= 200))
        && (!('savedTracks' in data) || (data.savedTracks is list && data.savedTracks.size() <= 150))
        && (!('homeLayout' in data) || (data.homeLayout is list && data.homeLayout.size() <= 10));
    }

    function isValidPromoRedemptionOnUser() {
      let data = request.resource.data;
      return data.plan == 'pro'
        && 'redeemedPromoCode' in data
        && data.redeemedPromoCode is string
        && data.redeemedPromoCode.size() >= 6
        && exists(/databases/$(database)/documents/promoCodes/$(data.redeemedPromoCode))
        && get(/databases/$(database)/documents/promoCodes/$(data.redeemedPromoCode)).data.used == false
        && getAfter(/databases/$(database)/documents/promoCodes/$(data.redeemedPromoCode)).data.used == true
        && getAfter(/databases/$(database)/documents/promoCodes/$(data.redeemedPromoCode)).data.usedByUid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if (isOwner(userId) || isAdmin())
        && isValidUserPayload(userId)
        && (
          isAdmin()
          || !('plan' in request.resource.data)
          || request.resource.data.plan == 'free'
          || isValidPromoRedemptionOnUser()
        );

      allow update: if isValidUserPayload(userId)
        && (
          isAdmin()
          || (
            isOwner(userId)
            && (
              request.resource.data.plan == resource.data.plan
              || (!('plan' in resource.data) && request.resource.data.plan == 'free')
              || isValidPromoRedemptionOnUser()
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /promoCodes/{code} {
      // Signed-in users can look up a specific code by exact ID to redeem it; only admin can list all codes.
      allow get: if isAuthenticated();
      allow list, create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdBy == resource.data.createdBy
        );
    }

    match /config/payments {
      allow get: if isAuthenticated();
      allow list, create, update, delete: if isAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
